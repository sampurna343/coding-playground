      "versionNonce": 338780045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785847363245,
      "link": null,
      "locked": false,
      "text": "Assumptions \n1. There will be multiple type of car",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumptions \n1. There will be multiple type of car",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VI_I5XJNpR5Vav0ORw8Os",
      "type": "text",
      "x": 121.9319300818255,
      "y": 2401.6020063018004,
      "width": 541.8558349609375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1m",
      "roundness": null,
      "seed": 2076963779,
      "version": 101,
      "versionNonce": 1576937923,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785848308801,
      "link": null,
      "locked": false,
      "text": "Out of scope\n1. Start/End trip is part of drivers app\n2. System will choose trip for me \n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Out of scope\n1. Start/End trip is part of drivers app\n2. System will choose trip for me \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
